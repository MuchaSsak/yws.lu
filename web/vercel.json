    },
    {
      "source": "/tecconference",
      "destination": "/en/tec-conference/",
      "permanent": true
    },
    {
      "source": "/tecconference/",
      "destination": "/en/tec-conference/",
      "permanent": true
    },
    {
      "source": "/Jobs",
      "destination": "/en/about-us/",
      "permanent": true
    },
    {
      "source": "/Jobs/",
