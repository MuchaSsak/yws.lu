    },
    {
      "source": "/RentYourProperty/",
      "destination": "/en/rent-your-property/",
      "permanent": true
    },
    {
      "source": "/rentyourproperty",
      "destination": "/en/rent-your-property/",
      "permanent": true
    },
    {
      "source": "/rentyourproperty/",
      "destination": "/en/rent-your-property/",
      "permanent": true
    },
    {
      "source": "/WeSparkProjects",
      "destination": "/en/youth-projects/",
      "permanent": true
    },
    {
      "source": "/WeSparkProjects/",
      "destination": "/en/youth-projects/",
      "permanent": true
    },
    {
      "source": "/wesparkprojects",
      "destination": "/en/youth-projects/",
      "permanent": true
    },
    {
      "source": "/wesparkprojects/",
      "destination": "/en/youth-projects/",
