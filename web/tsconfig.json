{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src", "scripts", "e2e", "*.ts", "*.mjs"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
