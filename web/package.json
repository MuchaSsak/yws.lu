    "@lingui/react": "6.9.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "lingui-for-astro": "0.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "simplex-noise": "4.0.3",
    "tailwindcss": "4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
