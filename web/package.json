{
  "name": "yws-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "node scripts/build.mjs",
    "preview": "node ./scripts/serve.mjs --port 4322",
    "check": "astro check && eslint . && prettier --check . --log-level warn && lingui check sync && vitest run",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write . --log-level warn",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:xb": "playwright test -c playwright.xb.config.ts",
    "lhci": "node scripts/lighthouse.mjs",
    "shots": "node scripts/shots.mjs",
    "og": "node scripts/og.mjs",
    "poster": "node ./scripts/poster.mjs",
    "background": "node ./scripts/background.mjs",
    "i18n:extract": "lingui extract --clean",
    "i18n:fill": "node scripts/fill-fr.mjs",
    "vercel:config": "bun scripts/vercel-config.ts",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:key": "node scripts/indexnow.mjs --new-key",
    "favicons": "node scripts/favicons.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/montserrat": "5.3.0",
    "@lingui/core": "6.9.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "cobe": "0.6.5",
    "lingui-for-astro": "0.7.1",
    "sharp": "0.35.5",
    "simplex-noise": "4.0.3",
    "tailwindcss": "4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "6.9.0",
    "@lingui/conf": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/native-tools": "0.1.6",
    "@lingui/vite-plugin": "6.9.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "0.186.0",
    "chrome-launcher": "1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-lingui": "^0.16.0",
    "globals": "^17.13.0",
    "lighthouse": "13.5.0",
    "path-to-regexp": "6.3.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.3"
  }
}
