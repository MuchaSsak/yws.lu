# Names only (wiki: .claude/project-info/tech/technologies.md § Env var names). Values live in Vercel → Settings →
# Environment Variables, set by the owner; none is needed for a local build.

# Origin override for canonical, hreflang, og:image and the sitemap (default: https://www.yws.lu; previews: VERCEL_URL).
PUBLIC_SITE_URL=
# "true" builds like production outside Vercel: indexable, placeholders block (same as `bun run build --launch`).
IS_FULL_PRODUCTION=
# Search engine verification metas, rendered only when set.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# PageSpeed Insights API quota for the case-study capture (optional).
PSI_API_KEY=
