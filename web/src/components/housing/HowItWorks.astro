---
/**
 * The four steps from application to a room (wiki: site/structure.md § Youth housing). An ordered list; the orange
 * beam fills as the list scrolls past (CSS scroll-driven, global.css § Timeline), static where unsupported. Each step
 * is numbered on the line (2025: an empty dot) and its number fills orange as it crosses the middle of the screen. The
 * title column sticks from 768 px only: on a phone the 2025 sticky dot floated over the next step.
 */
import { t } from "lingui-for-astro/macro";

import Section from "~/components/ui/Section.astro";

const steps = [
  {
    title: t`Fill Out the Form`,
    text: t`Start by completing a short application form. This helps us understand your situation and what kind of housing you need.`,
  },
  {
    title: t`Let's Talk`,
    text: t`After we receive your application, someone from our team will contact you to schedule a meeting. We'll talk about your background, current needs, and how we can support you.`,
  },
  {
    title: t`Personal Interview`,
    text: t`During your appointment, we'll go into more detail and assess whether one of our houses could be a good fit for you.`,
  },
  {
    title: t`Our Selection Process`,
    text: t`After the interviews, our team carefully reviews all applications and selects candidates based on key criteria like urgency, motivation, and readiness for communal living.`,
  },
];
---

<Section labelledby="how-it-works">
  <div class="w-full md:px-10" style="view-timeline-name: --timeline">
    <div class="relative mx-auto max-w-7xl">
      <h2 id="how-it-works" class="text-orange-gradient px-4 pb-14 text-3xl font-black sm:text-5xl sm:leading-20">
        {t`Here's how it works`}
      </h2>
      <ol class="flex flex-col gap-16">
        {steps.map((step, index) => (
          <li class="flex justify-start md:gap-10">
            <div class="z-(--z-sticky) flex max-w-xs flex-col self-start md:sticky md:top-40 md:w-full md:flex-row lg:max-w-sm">
              <div class="absolute left-3 flex size-10 items-center justify-center" aria-hidden="true">
                <span class="step-marker">{index + 1}</span>
              </div>
              <h3 class="text-xl font-bold max-md:hidden md:pl-20 md:text-4xl">{step.title}</h3>
            </div>
            <div class="relative w-full pr-2 pl-16 md:pr-4 md:pl-4">
              <h3 class="mb-4 text-left text-2xl font-bold md:hidden">{step.title}</h3>
              <p class="step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div
        class="absolute top-0 left-8 h-full w-[2px] overflow-hidden bg-linear-to-b from-transparent via-neutral-200 to-transparent to-99% mask-[linear-gradient(to_bottom,transparent_0%,black_10%,black_90%,transparent_100%)]"
        aria-hidden="true"
      >
        <div class="timeline-beam absolute inset-0"></div>
      </div>
    </div>
  </div>
</Section>

<style>
  .step-marker {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid color-mix(in oklab, var(--color-primary) 50%, white);
    border-radius: 9999px;
    background: var(--color-background);
    box-shadow: 0 0 0 6px rgb(255 255 255 / 0.6);
    color: var(--color-primary-strong);
    font-weight: 800;
  }
  /* Filled as the step crosses the middle of the screen, in step with the beam (longhands: lessons.md). */
  @supports (animation-timeline: view()) {
    .step-marker {
      animation-name: step-reached;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range-start: cover 40%;
      animation-range-end: cover 50%;
    }
  }
  @keyframes step-reached {
    to {
      border-color: var(--color-primary);
      background: var(--color-primary);
      color: var(--color-primary-foreground);
    }
  }
  .step-text {
    max-width: 38rem;
    margin-bottom: 2rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .step-text {
      font-size: var(--text-lg);
    }
  }
</style>
