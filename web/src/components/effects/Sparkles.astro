---
/**
 * A word with twinkling stars around it (adapted from Magic UI's SparklesText, MIT; THIRD_PARTY_NOTICES.md). The
 * stars are placed at build time with a fixed seed, so every build and screenshot is the same. Each star is an HTML
 * span around its svg, and the span animates: an animated <svg> re-styles and repaints on the main thread every frame
 * (lessons.md), a span's transform and opacity run on the compositor. They twinkle only while on screen (data-loop).
 */
interface Props {
  count?: number;
  colors?: [string, string];
  class?: string;
}

const { count = 7, colors = ["#b96ff9", "#730bce"], class: className } = Astro.props;

// Small deterministic generator (mulberry32) so positions don't change between builds.
let seed = 0x9e3779b9;
const random = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let value = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  value = (value + Math.imul(value ^ (value >>> 7), 61 | value)) ^ value;
  return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
};
const stars = Array.from({ length: count }, () => ({
  left: `${(random() * 100).toFixed(1)}%`,
  top: `${(random() * 100).toFixed(1)}%`,
  color: random() > 0.5 ? colors[0] : colors[1],
  delay: `${(random() * 2).toFixed(2)}s`,
  scale: (random() + 0.3).toFixed(2),
}));
---

<span class:list={["sparkles", className]} data-loop>
  {stars.map((star) => (
    <span
      class="sparkle"
      style={`left: ${star.left}; top: ${star.top}; --delay: ${star.delay}; --scale: ${star.scale}`}
      aria-hidden="true"
    >
      <svg viewBox="0 0 21 21">
        <path
          d="M9.82531 0.843845C10.0553 0.215178 10.9446 0.215178 11.1746 0.843845L11.8618 2.72026C12.4006 4.19229 12.3916 6.39157 13.5 7.5C14.6084 8.60843 16.8077 8.59935 18.2797 9.13822L20.1561 9.82534C20.7858 10.0553 20.7858 10.9447 20.1561 11.1747L18.2797 11.8618C16.8077 12.4007 14.6084 12.3916 13.5 13.5C12.3916 14.6084 12.4006 16.8077 11.8618 18.2798L11.1746 20.1562C10.9446 20.7858 10.0553 20.7858 9.82531 20.1562L9.13819 18.2798C8.59932 16.8077 8.60843 14.6084 7.5 13.5C6.39157 12.3916 4.19225 12.4007 2.72023 11.8618L0.843814 11.1747C0.215148 10.9447 0.215148 10.0553 0.843814 9.82534L2.72023 9.13822C4.19225 8.59935 6.39157 8.60843 7.5 7.5C8.60843 6.39157 8.59932 4.19229 9.13819 2.72026L9.82531 0.843845Z"
          fill={star.color}
        />
      </svg>
    </span>
  ))}
  <strong>
    <slot />
  </strong>
</span>
