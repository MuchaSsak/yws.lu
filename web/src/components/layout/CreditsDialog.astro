---
/**
 * "See credits" (wiki: design/assets.md § Credits, requirements F10): every CC BY work the site shows, with title,
 * source, author, licence and "modified", then the 2025 dialog's lead-developer line (Q4: unchanged). A native
 * <dialog>: modal, focus moves in and back, Escape closes, the page behind is inert (2025: a Radix dialog whose
 * overlay class was malformed, a 16 px close icon at 70 % opacity).
 */
import { t } from "lingui-for-astro/macro";

import CreditLine from "~/components/layout/CreditLine.astro";
import NewTab from "~/components/ui/NewTab.astro";
import { CREDITS, LEAD_DEVELOPER } from "~/data/credits";
---

<button type="button" class="credits-open" data-credits-open>{t`See credits`}</button>
<dialog class="credits" aria-labelledby="credits-title" data-credits>
  <h2 id="credits-title">{t`Credits 💖`}</h2>
  <ul>
    {CREDITS.map((credit) => (
      <CreditLine credit={credit} />
    ))}
  </ul>
  <p class="credits-dev">
    {t`Lead Developer`}{" "}
    <a href={LEAD_DEVELOPER.href} target="_blank" rel="noopener">
      {LEAD_DEVELOPER.name}
      <NewTab />
    </a>
  </p>
  <div class="credits-close-row">
    <button type="button" class="btn" data-credits-close>{t`Cheers to them!`}</button>
  </div>
</dialog>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-credits]")) {
    const opener = dialog.previousElementSibling as HTMLButtonElement | null;
    opener?.addEventListener("click", () => dialog.showModal());
    dialog.querySelector("[data-credits-close]")?.addEventListener("click", () => dialog.close());
    // A click on the backdrop (outside the box) closes it too.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .credits-open {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  /* Centred: Tailwind's reset sets every margin to 0, which removed the browser's `margin: auto` for modal dialogs
     and pinned this one to the top-left corner. It rises and fades in over a blurred, dimmed page, and back out. */
  .credits {
    width: min(36rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1.75rem;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.25);
    --focus-ring: var(--color-primary-strong);
    transition:
      opacity 0.25s var(--ease-out),
      translate 0.35s var(--ease-out),
      scale 0.35s var(--ease-out),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }
  .credits:not([open]) {
    opacity: 0;
    translate: 0 1rem;
    scale: 0.97;
  }
  @starting-style {
    .credits[open] {
      opacity: 0;
      translate: 0 1rem;
      scale: 0.97;
    }
  }
  .credits::backdrop {
    background: rgb(0 0 0 / 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition:
      background-color 0.35s var(--ease-out),
      backdrop-filter 0.35s var(--ease-out),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }
  @starting-style {
    .credits[open]::backdrop {
      background: rgb(0 0 0 / 0);
      -webkit-backdrop-filter: blur(0);
      backdrop-filter: blur(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .credits,
    .credits::backdrop {
      transition: none;
    }
  }
  .credits h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .credits ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.55;
  }
  .credits a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .credits-dev {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .credits-close-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }
</style>
