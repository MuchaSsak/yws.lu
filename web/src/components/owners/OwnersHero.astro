---
/**
 * Rent your property, the hero (wiki: site/structure.md § Rent your property 1): the H1 with the orange highlight on
 * "safe, reliable & impactful" and three lines, each sweeping in behind the reveal box as in 2025. Behind them, warm
 * sparks stream out from the headline: the 2025 background lines (Aceternity), rewritten as own code (Q23,
 * src/scripts/spark-lines-core.ts), drawn in a worker after the page is idle, faded where the words are (in 2025 they
 * crossed them). Reduced motion: no canvas.
 */
import { t } from "lingui-for-astro/macro";

import Reveal from "~/components/effects/Reveal.astro";
---

<section class="owners-hero relative isolate px-side">
  <div class="spark-lines absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="flex flex-col items-center text-center">
    <Reveal duration={0.5}>
      <h1 class="owners-title">
        <span>{t`Rent your property with confidence:`}</span>{" "}
        <span class="highlight font-bold italic">{t`safe, reliable & impactful`}</span>
      </h1>
    </Reveal>
    <div class="owners-lede">
      <Reveal rise duration={0.5}>
        <p>{t`We are always looking to rent any type of residential property — whether it's a house, apartment, or individual room.`}</p>
      </Reveal>
      <Reveal rise duration={0.6}>
        <p>{t`Our goal is to offer safe, affordable housing to young people in need, and we do it in partnership with property owners like you.`}</p>
      </Reveal>
      <Reveal rise duration={0.7}>
        <p>{t`By working with us, you're not only helping build someone's future — you also enjoy a reliable, worry-free rental experience.`}</p>
      </Reveal>
    </div>
  </div>
</section>

<script>
  import { mountSparkLines } from "~/scripts/spark-lines";

  const start = () => {
    const host = document.querySelector(".spark-lines");
    if (!host) return;
    const canvas = host.appendChild(document.createElement("canvas"));
    canvas.className = "size-full";
    mountSparkLines(canvas, { count: innerWidth < 768 ? 32 : 56 });
  };
  // After the page has loaded and gone idle: the sparks never compete with the first paint.
  const idle = () => ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 200));
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    if (document.readyState === "complete") idle();
    else addEventListener("load", idle, { once: true });
  }
</script>

<style>
  /* Sparks show around the words, faint across them: an ellipse over the text block fades the canvas there. On phones
     the text spans the screen, so the ellipse does too and the sparks show in full only above and in the corners. */
  .spark-lines {
    --spark-mask: radial-gradient(ellipse 75% 40% at 50% 52%, rgb(0 0 0 / 0.15) 70%, #000 100%);
    -webkit-mask-image: var(--spark-mask);
    mask-image: var(--spark-mask);
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .spark-lines {
      --spark-mask: radial-gradient(ellipse 46% 40% at 50% 48%, rgb(0 0 0 / 0.1) 60%, #000 100%);
    }
  }
  /* The 2025 hero: at least one screen tall, 144 px from the top on phones, 192 from 768, 256 from 1280; 600 weight,
     tight tracking. */
  .owners-hero {
    min-height: 100svh;
    padding-top: 9rem;
  }
  @media (min-width: 768px) {
    .owners-hero {
      padding-top: 12rem;
    }
  }
  @media (min-width: 1280px) {
    .owners-hero {
      padding-top: 16rem;
    }
  }
  /* Capped so wide screens keep the two balanced lines of 1440 (one 1,600–1,800 px line from 1920 otherwise). */
  .owners-title {
    max-width: 75rem;
    font-size: var(--text-h2);
    line-height: 3.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  @media (min-width: 640px) {
    .owners-title {
      line-height: 5rem;
    }
  }
  .owners-lede {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-width: var(--measure);
    padding-block: 2rem;
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    text-wrap: balance;
  }
</style>
