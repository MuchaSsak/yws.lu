---
/**
 * Privacy policy and legal notice (wiki: site/structure.md § Legal pages, legal/compliance-and-data.md): the text of
 * the `legal` collection for this locale under its H1 and version date. Facts only; every unknown is a visible
 * placeholder marker until the client approves (a launch build fails on any left). A document layout, no effects: the
 * sections' contents beside the text from 1024 px (sticky, the section being read marked), a "Contents" disclosure
 * above it on smaller screens; a paragraph that is bold throughout (the privacy policy's right to object, which
 * GDPR art. 21(4) wants presented clearly and apart) is set as a callout.
 */
import { getEntry, render } from "astro:content";
import { t } from "lingui-for-astro/macro";

import { formatDate } from "~/lib/format";

interface Props {
  page: "privacy" | "legal";
}

const { page } = Astro.props;
const locale = Astro.locals.locale;
const entry = await getEntry("legal", `${locale}/${page}`);
if (!entry) throw new Error(`no legal text for ${locale}/${page}`);
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const contents = t`Contents`;
const updated = formatDate(entry.data.updated.toISOString().slice(0, 10), locale);
---

<article class="legal px-side">
  <div class="legal-shell">
    <h1 class="legal-title">{entry.data.title}</h1>
    <p class="legal-updated">{t`Last updated: ${updated}`}</p>
    <div class="legal-body">
      <nav class="legal-toc" aria-label={contents} data-legal-toc>
        <details open>
          <summary>{contents}</summary>
          <ol>
            {sections.map((section) => (
              <li>
                <a href={`#${section.slug}`}>{section.text}</a>
              </li>
            ))}
          </ol>
        </details>
      </nav>
      <div class="legal-text">
        <Content />
      </div>
    </div>
  </div>
</article>

<script>
  // Phones start with the contents folded (the text comes first); wide screens keep them open beside the text and mark
  // the section being read.
  const toc = document.querySelector<HTMLElement>("[data-legal-toc]");
  const wide = matchMedia("(min-width: 1024px)");
  const details = toc?.querySelector("details");
  if (details && !wide.matches) details.open = false;
  const links = new Map([...(toc?.querySelectorAll<HTMLAnchorElement>("a") ?? [])].map((link) => [link.hash.slice(1), link]));
  const mark = (id: string) => {
    for (const [slug, link] of links) link.toggleAttribute("aria-current", slug === id);
  };
  // A heading in the band between 20 % and 30 % from the top of the screen is the section being read.
  const seen = new IntersectionObserver(
    (entries) => {
      const top = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (top) mark(top.target.id);
    },
    { rootMargin: "-20% 0px -70% 0px" },
  );
  for (const id of links.keys()) {
    const heading = document.getElementById(id);
    if (heading) seen.observe(heading);
  }
</script>

<style>
  .legal {
    padding-block: var(--space-hero-top) var(--space-section);
  }
  /* The sections' shell, so the text lines up with the header on wide screens. */
  .legal-shell {
    max-width: var(--content-max);
    margin-inline: auto;
  }
  /* Boxes as wide as their text: the layout gate measures boxes, and nothing here is a full-width block. */
  .legal-title {
    width: fit-content;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    font-weight: 900;
  }
  .legal-updated {
    width: fit-content;
    padding-top: 0.5rem;
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
  }
  .legal-body {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
  }
  @media (min-width: 1024px) {
    .legal-body {
      grid-template-columns: 17rem minmax(0, 70ch);
      gap: 4rem;
      align-items: start;
    }
  }
  .legal-toc {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.7);
    font-size: var(--text-sm);
  }
  @media (min-width: 1024px) {
    .legal-toc {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      max-height: calc(100dvh - var(--header-h) - 4rem);
      overflow-y: auto;
    }
  }
  .legal-toc summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .legal-toc ol {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0 0.5rem 0.75rem;
    list-style: none;
  }
  .legal-toc a {
    display: block;
    padding: 0.375rem 0.5rem;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-muted-foreground);
    line-height: 1.35;
    transition:
      color var(--dur-1),
      border-color var(--dur-1),
      background-color var(--dur-1);
  }
  .legal-toc a:hover,
  .legal-toc a[aria-current] {
    border-left-color: var(--color-primary);
    background: color-mix(in oklab, var(--color-primary) 8%, transparent);
    color: var(--color-foreground);
  }
  .legal-text {
    max-width: 70ch;
    line-height: 1.7;
  }
  .legal-text > :global(:first-child) {
    margin-top: 0;
  }
  .legal-text :global(h2) {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    font-weight: 700;
  }
  .legal-text :global(h3) {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .legal-text :global(p),
  .legal-text :global(ul) {
    margin-top: 0.75rem;
  }
  .legal-text :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal-text :global(li + li) {
    margin-top: 0.25rem;
  }
  .legal-text :global(a) {
    color: var(--color-primary-strong);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }
  .legal-text :global(a[href^="tel:"]) {
    white-space: nowrap;
  }
  .legal-text :global(code) {
    font-size: 0.9em;
  }
  /* A paragraph bold throughout (the right to object): a callout, set apart as GDPR art. 21(4) asks. */
  .legal-text :global(p:has(> strong:only-child)) {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: color-mix(in oklab, var(--color-primary) 8%, white);
  }
</style>
