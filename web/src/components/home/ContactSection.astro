---
/**
 * Contact us (wiki: site/structure.md § Home 6, § Embeds): socials, email and both phones as real links (the 2025 email
 * and phones were plain text), and the office map: Google's embed loads by itself as the section nears the screen
 * (native lazy loading, as in 2025) [user 2026-10-09], never on the first screen; a drawn grid and the address hold
 * its place until it paints. Under it, the address, "Open in Google Maps" and a line pointing to the privacy policy
 * (Google receives the visitor's IP address when the map loads: legal/compliance-and-data.md). `#contact` is the
 * anchor the menus use; `#contact-section` keeps the 2025 anchor working [assumption]. No form, ever [user 2026-10-09].
 */
import { t } from "lingui-for-astro/macro";

import Sparkles from "~/components/effects/Sparkles.astro";
import ContactActions from "~/components/ui/ContactActions.astro";
import CopyButton from "~/components/ui/CopyButton.astro";
import Icon from "~/components/ui/Icon.astro";
import NewTab from "~/components/ui/NewTab.astro";
import Section from "~/components/ui/Section.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { ORGANISATION } from "~/data/organisation";
import { pathTo } from "~/lib/routes";

const { office } = ORGANISATION;
const address = `${office.street}, ${office.postalCode} ${office.locality}`;
const openMap = t`Open in Google Maps`;
const mapTitle = t`Map: ${address}`;
const privacy = pathTo(Astro.locals.locale, "privacy");
---

<Section id="contact" labelledby="contact-title" class="contact">
  <span id="contact-section" class="contact-alias" aria-hidden="true"></span>
  <div class="contact-grid">
    <div class="contact-info">
      <SectionHeader id="contact-title" effect="plain" align="start">
        <Sparkles slot="title" colors={["#ff7820", "#ffd120"]} class="pr-4">{t`Contact us`}</Sparkles>
      </SectionHeader>
      <ContactActions socials />
    </div>

    <figure class="contact-map">
      <div class="contact-map-canvas">
        <p class="contact-map-placeholder" aria-hidden="true">
          <Icon name="map-pin" size={40} class="text-ink-orange" />
          <span>{address}</span>
        </p>
        <iframe
          class="contact-map-frame"
          src={office.embed}
          title={mapTitle}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <figcaption class="contact-map-caption">
        <p class="contact-map-address">
          <span class="font-semibold">{office.label}</span>
          <span>{address}</span>
        </p>
        <CopyButton value={address} what={address} class="contact-map-copy" />
        <a href={office.maps} target="_blank" rel="noopener" class="contact-map-link">
          {openMap}
          <NewTab />
        </a>
        <p class="contact-map-note">
          {t`Map by Google Maps.`} <a href={privacy}>{t`How your data is handled`}</a>
        </p>
      </figcaption>
    </figure>
  </div>
</Section>

<style>
  .contact-alias {
    position: absolute;
  }
  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  @media (min-width: 1280px) {
    .contact-grid {
      flex-direction: row;
      align-items: center;
    }
    .contact-grid > * {
      flex: 1;
    }
  }
  .contact-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 1280px) {
    .contact-info {
      align-items: flex-start;
    }
  }
  .contact-map {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }
  /* The map's place: a drawn grid and the address until Google's tiles paint over them. */
  .contact-map-canvas {
    position: relative;
    height: 30rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(var(--color-border) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      var(--color-background);
  }
  .contact-map-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0;
    padding: 1.5rem;
    font-size: var(--text-lg);
    text-align: center;
  }
  .contact-map-placeholder span {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-background);
  }
  .contact-map-frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .contact-map-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }
  .contact-map-address {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .contact-map-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-primary-strong);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-map-note {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
  }
  .contact-map-note a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
