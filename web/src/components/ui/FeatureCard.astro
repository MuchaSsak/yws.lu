---
/**
 * A feature card (wiki: design/design.md § Components: the 2025 GlareCard, rewritten as own code, Q23): 3 rem radius,
 * the ink-orange icon on a soft orange badge, centred title (h3) and text on glass over the page glow. Cards rise into
 * view one after another (`index` staggers them, 80 ms apart; 2025: 125 ms) and a sheen crosses each once as it lands,
 * the 2025 glare without the pointer; hovering lifts the card. Each card hugs its text and
 * a row takes its tallest card's height (the 2025 17:21 boxes left a third of each card empty). Put cards in a
 * `<ul class="feature-cards">`. `compact`: a one-line fact (the TEC Q&A).
 */
import Icon from "~/components/ui/Icon.astro";

interface Props {
  icon:
    | "hand-coins"
    | "dollar-sign"
    | "heart-handshake"
    | "land-plot"
    | "brush-cleaning"
    | "book-open-check"
    | "piggy-bank"
    | "armchair"
    | "calendar-1"
    | "headset";
  title: string;
  index?: number;
  compact?: boolean;
}

const { icon, title, index = 0, compact = false } = Astro.props;
---

<li class:list={["feature-card", compact && "feature-card-compact"]} data-inview="rise" style={`--i: ${index}`}>
  <span class="feature-card-badge">
    <Icon name={icon} size={compact ? 32 : 44} class="text-ink-orange" />
  </span>
  <h3 class="feature-card-title">{title}</h3>
  <p class="feature-card-text">
    <slot />
  </p>
</li>

<style>
  .feature-card {
    position: relative;
    display: flex;
    flex: 0 1 20rem;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 2rem 1.25rem 2.25rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: var(--radius-feature);
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.72), rgb(255 255 255 / 0.38));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 18px 40px -24px rgb(120 60 20 / 0.3);
    text-align: center;
    /* The rise (global.css § Fade in), the hover lift and border share one transition list. */
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      translate var(--dur-2) var(--ease-out),
      transform var(--dur-3) var(--ease-out) calc(var(--i, 0) * 80ms);
  }
  .feature-card:hover {
    translate: 0 -4px;
    border-color: color-mix(in oklab, var(--color-primary) 55%, white);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 28px 50px -24px rgb(194 65 12 / 0.4);
  }
  /* The glare: a band of light crossing the card, transform only (no repaint). */
  .feature-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 35%, rgb(255 255 255 / 0.75) 50%, transparent 65%);
    translate: -110% 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .feature-card:global(.is-in)::after {
      animation-name: feature-sheen;
      animation-duration: 1.1s;
      animation-delay: calc(0.35s + var(--i, 0) * 80ms);
      animation-timing-function: var(--ease-in-out);
      animation-fill-mode: both;
    }
  }
  @keyframes feature-sheen {
    from {
      translate: -110% 0;
    }
    to {
      translate: 110% 0;
    }
  }
  .feature-card-badge {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    margin-bottom: 0.5rem;
    border-radius: 9999px;
    background: radial-gradient(circle at 30% 25%, white, color-mix(in oklab, var(--color-primary) 18%, white) 70%);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-primary) 22%, white),
      0 8px 18px -10px rgb(194 65 12 / 0.5);
  }
  .feature-card-compact .feature-card-badge {
    width: 3.75rem;
    height: 3.75rem;
  }
  .feature-card-title {
    padding-bottom: 0.25rem;
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    font-weight: 600;
    text-wrap: balance;
  }
  .feature-card-text {
    font-weight: 500;
    text-wrap: pretty;
  }
  :global(.feature-cards) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    padding-top: 3rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      transition: none;
    }
  }
</style>
