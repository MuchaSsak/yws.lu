---
/**
 * Every page's document: head (SEO, hreflang, share card, JSON-LD), skip link, header, main, footer.
 * Wiki: site/seo.md § Metadata rules, site/i18n.md, design/design.md. Title and description come from the metadata
 * table (src/lib/meta.ts) for routed pages; the 404 passes its own. Robots: indexable only in a launch build
 * (scripts/launch.mjs), never for legal pages and the 404.
 */
import "@fontsource-variable/montserrat/wght.css";
import "~/styles/global.css";

import montserratLatin from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";

import { t } from "lingui-for-astro/macro";

import BodyBackground from "~/components/layout/BodyBackground.astro";
import SiteFooter from "~/components/layout/SiteFooter.astro";
import SiteHeader from "~/components/layout/SiteHeader.astro";
import { getI18n } from "~/lib/i18n";
import { LOCALES, OG_LOCALES } from "~/lib/locales";
import { fullTitle, META, MISSION, SITE_NAME } from "~/lib/meta";
import { alternates, INDEXABLE, pathTo, type RouteId } from "~/lib/routes";
import { schemaGraph } from "~/lib/schema";
import { isLaunchBuild } from "../../scripts/launch.mjs";

interface Props {
  /** The route this page is; null for pages without a canonical (the 404). */
  route: RouteId | null;
  /** Only for pages outside the metadata table (the 404). */
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { route, noindex = false } = Astro.props;
const locale = Astro.locals.locale;
const i18n = getI18n(locale);
const site = Astro.site ?? new URL("https://www.yws.lu");
const origin = site.origin;
const meta = route ? META[route] : null;
const pageTitle = meta ? i18n._(meta.title) : (Astro.props.title ?? SITE_NAME);
const description = meta ? i18n._(meta.description) : (Astro.props.description ?? "");
const title = fullTitle(pageTitle, meta?.full ?? false);
const canonical = route === null ? null : new URL(pathTo(locale, route), site).href;
const links = route === null ? [] : alternates(site, route);
const hidden = noindex || route === null || !INDEXABLE.includes(route);
const robots = isLaunchBuild() && !hidden ? "index, follow, max-image-preview:large" : "noindex, follow";
const ogImage = route ? `${origin}/og/${locale}-${route}.png` : null;
const ogAlt = `${pageTitle} – ${SITE_NAME}`;
const mission = i18n._(MISSION);
const jsonLd = route
  ? schemaGraph({ site: origin, locale, route, name: pageTitle, description, mission, ...(ogImage ? { image: ogImage } : {}) })
  : null;
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION as string | undefined;
const bingVerification = import.meta.env.BING_SITE_VERIFICATION as string | undefined;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {links.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ff6900" />
    <!-- The client's 32 px icon only: larger icons, apple-touch-icon and a manifest wait for a master (Q33). -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={meta?.full ? title : pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogAlt} />
      </>
    )}
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALES.filter((other) => other !== locale).map((other) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[other]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only-focusable skip-link">{t`Skip to content`}</a>
    <BodyBackground />
    <SiteHeader route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter route={route} />
    <script>
      import "~/scripts/inview";
      import "~/scripts/anchor-jumps";
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: var(--z-skip);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--color-foreground);
    color: var(--color-background);
    font-weight: 700;
    --focus-ring: #fff;
  }
  main:focus {
    outline: none;
  }
</style>
