---
/**
 * Every inner page, once per locale, from the one route map (wiki: site/i18n.md § URLs). The slug decides the
 * route id; the id decides the page content; title and description come from the metadata table (src/lib/meta.ts).
 */
import AboutHero from "~/components/about/AboutHero.astro";
import OurMission from "~/components/about/OurMission.astro";
import RealImpact from "~/components/about/RealImpact.astro";
import HousingHero from "~/components/housing/HousingHero.astro";
import HowItWorks from "~/components/housing/HowItWorks.astro";
import LegalPage from "~/components/legal/LegalPage.astro";
import WhoGetsPriority from "~/components/housing/WhoGetsPriority.astro";
import OwnersContact from "~/components/owners/OwnersContact.astro";
import OwnersHero from "~/components/owners/OwnersHero.astro";
import WhyRentToUs from "~/components/owners/WhyRentToUs.astro";
import ProjectsPage from "~/components/projects/ProjectsPage.astro";
import TecPage from "~/components/tec/TecPage.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { pageStaticPaths, type RouteId } from "~/lib/routes";

export const getStaticPaths = pageStaticPaths;

const { id } = Astro.props as { id: RouteId };
---

<BaseLayout route={id}>
  {id === "housing" && (
    <>
      <HousingHero />
      <HowItWorks />
      <WhoGetsPriority />
    </>
  )}
  {id === "owners" && (
    <>
      <OwnersHero />
      <WhyRentToUs />
      <OwnersContact />
    </>
  )}
  {id === "projects" && <ProjectsPage />}
  {id === "tec" && <TecPage />}
  {(id === "privacy" || id === "legal") && <LegalPage page={id} />}
  {id === "about" && (
    <>
      <AboutHero />
      <OurMission />
      <RealImpact />
    </>
  )}
</BaseLayout>
